# Optional development server port; the desktop backend uses 7419.
VITE_WEB_PORT=7420

# Optional OAuth clients for MCP connectors. Set these in the host environment.
# Never put secrets in VITE_ variables or distribute a shared client secret.
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=
MCP_GITHUB_REDIRECT_URI=http://127.0.0.1:8765/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/callback
