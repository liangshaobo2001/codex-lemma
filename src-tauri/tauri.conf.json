{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Lemma",
  "version": "../package.json",
  "identifier": "app.codexlemma",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Codex Lemma",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 360,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 22
        },
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: tauri://*; style-src 'self' 'unsafe-inline' https: http:; img-src 'self' asset: https://asset.localhost blob: data: https: http:; font-src 'self' data: https: http: tauri://*; connect-src 'self' ipc: https://ipc.localhost http://ipc.localhost http://localhost:* https: http: ws: wss:; frame-src 'self' data: about: http://localhost:* http://127.0.0.1:* https://*;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "$HOME/.cache/**/*",
          "$HOME/.codex/.tmp/**/*",
          "$HOME/.codex/plugins/**/*",
          "$HOME/.codex/skills/**/*",
          "$HOME/.codex/skills/.system/**/*",
          "$HOME/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "codex-lemma"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NzBDMDMxQUVDMDk3NUIKUldSYmw4Q3VNY0J3bVVjaEQ1OGZWU2VCWFRoT2dwR2RQQW5Pc0ozaXVud08wWkFsY0pBcm1JMGoK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
